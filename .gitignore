# 基本はすべて公開せず、下に書いたファイルだけを公開する
/*
!/.gitignore
!/README.md
!/main.py
!/pyproject.toml
!/model/
!/tool/
!/utils/
!/docs/
!/website/
!/.github/
!/config/


# docs: 画像だけ (仕様、コーディングルール、読むものの一覧は手元に置く)
/docs/*
!/docs/img/

# model: コードと model/weight/<モデル名>/ のトークナイザー。重みは除く
/model/weight/**/*.pth
/model/weight/**/*.pt
/model/weight/**/*.safetensors
/model/weight/**/.cache/

# website: Docusaurus のパッケージ、ビルド、キャッシュは除く
/website/node_modules/
/website/build/
/website/.docusaurus/

# どこにあっても Python のキャッシュは除く
__pycache__/
*.py[cod]
